// Document Builder — multi-tenant issuance and verification.
//
// The whole difference from the single-brand system this descends from is that
// nothing here is NorthWhale. Every name, address, colour, logo, watermark and
// seal belongs to an Organisation row, and a document carries the id of the
// organisation that issued it. The verification portal renders a scanned
// document in *that* organisation's identity, which is the entire point: a
// recipient who scans a code should see the institution that wrote to them, not
// the platform that generated it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// A tenant. Everything a document needs in order to look like it came from
/// somebody in particular.
///
/// ── Why the assets live in the database ─────────────────────────────────
///
/// Logos, watermarks and seals are stored as data URLs on this row rather than
/// in object storage. Render's filesystem is ephemeral — anything written to
/// disk is gone on the next deploy — so local upload was never an option, and
/// adding S3 or Cloudinary means a second service, a second set of credentials
/// and a second thing that can be down when somebody needs to print.
///
/// MongoDB documents cap at 16MB. Brand assets are small by nature: a logo is a
/// few hundred kilobytes and the upload route re-encodes anything larger. Two
/// or three of those sit comfortably inside the limit, and the row is read once
/// per document render. When a tenant needs a media library rather than a
/// brand kit, that is the moment to introduce storage — not before.
model Organisation {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId

  /// URL-safe identifier. Appears in verification links, so it is public and
  /// permanent: changing it breaks every code already printed.
  slug        String  @unique
  /// Display name, used conversationally. "Northwind Trust"
  name        String
  /// Full legal name for document footers and legal copy.
  legalName   String

  addressLine1 String @default("")
  addressLine2 String @default("")
  country      String @default("")
  supportEmail String @default("")
  website      String @default("")

  /// Brand assets, as data URLs. Null means "fall back to type" — a document
  /// with no logo sets the name instead, which is a real letterhead rather
  /// than a hole where one should be.
  logo        String?
  /// Sits behind the body at low opacity.
  watermark   String?
  /// Struck beside the signature.
  seal        String?

  /// Accent, as hex. Drives rules, labels and the portal's furniture, so a
  /// tenant's documents read as theirs at a glance.
  accentColor String @default("#0F5F5C")
  /// Ink for body copy. Near-black rather than black on paper.
  inkColor    String @default("#1B2733")

  /// Reference prefix, e.g. "NWT" -> NWT-260803-A4F2. Falls back to the slug.
  referencePrefix String @default("")

  members     Membership[]
  documents   Document[]
  templates   DocumentTemplate[]
  signatories Signatory[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A person who can sign in and act for an organisation.
///
/// Auth is per-user; authority is per-membership. Someone may hold accounts at
/// two organisations, and a document must record which one they were acting for
/// when they issued it.
model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  password      String
  name          String
  emailVerified Boolean  @default(false)
  /// Platform operator, as distinct from an organisation administrator.
  isPlatformAdmin Boolean @default(false)

  /// When this account paid for access. Null means it has not.
  ///
  /// A one-off unlock, so this is a timestamp rather than an expiry: once set
  /// it is never cleared by the passage of time. It gates the workspace only —
  /// never /verify, because a recipient holding a letter is not a customer and
  /// must never be asked to pay to check a reference.
  unlockedAt    DateTime?
  /// Which payment did it. Kept so support can answer "I paid, what happened".
  unlockedBy    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   Membership[]
  authTokens    AuthToken[]
  payments      Payment[]
}

/// Platform configuration a platform operator can change without a redeploy.
///
/// A single row. Wallet addresses started life as environment variables, which
/// is fine until the person who needs to rotate one is the person who cannot
/// reach the Render dashboard at eleven at night. Editing a row is also
/// auditable in a way that editing an env var is not.
///
/// Environment variables remain the fallback and are read when a field here is
/// blank, so an existing deployment keeps working and a fresh one can be
/// configured either way.
///
/// Nothing secret lives here. A receiving address is public by construction —
/// it is what you hand to somebody so they can pay you — and no private key,
/// seed or mnemonic is stored by this application anywhere, which is why it can
/// never move a customer's money or its own.
model PlatformSettings {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Always "singleton". Unique, so a second row cannot be created by a race
  /// and then silently disagree with the first.
  key               String   @unique @default("singleton")

  /// Price of the one-off unlock, in US cents.
  priceCents        Int      @default(4900)

  btcAddress        String   @default("")
  usdtTronAddress   String   @default("")

  /// Operator-supplied payment QR codes, as data URLs.
  ///
  /// The application generates a correct QR from the address on its own. These
  /// exist because a wallet or exchange sometimes issues a code carrying more
  /// than an address — a memo, a payment id, an amount — and a generated code
  /// would quietly drop it. When one is uploaded it is shown instead, and the
  /// address is still printed beneath it so a payer can check the two agree.
  btcQr             String?
  usdtQr            String?

  /// Shown on the unlock screen above the price.
  offerHeadline     String   @default("")
  offerNote         String   @default("")

  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// An invoice, and the chain watching that settles it.
///
/// ── How a payment is matched ──────────────────────────────────────────────
///
/// Funds go straight to the operator's own wallet — there is no processor and
/// no custody here — which means every invoice shares one receiving address per
/// chain. What distinguishes them is the amount: each invoice is issued for a
/// slightly unique figure, and the watcher looks for a transfer of exactly that
/// figure to that address, dated after the invoice was raised.
///
/// The honest limitation, stated because it is easy to pretend otherwise: this
/// is amount-matching, not address-per-invoice. Uniqueness is enforced against
/// every other *open* invoice, and the window is short, so a collision needs
/// two payers to be quoted the same figure within the same half hour. Per
/// invoice addresses would remove even that, and would need an extended public
/// key for Bitcoin and a different wallet arrangement for Tron. When volume
/// makes the collision real rather than theoretical, that is the change to
/// make.
model Payment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])

  /// BTC | USDT
  asset         String
  /// BITCOIN | TRON
  chain         String
  /// The operator's receiving address, copied at issue time. Kept on the row
  /// so that rotating the configured wallet cannot orphan an open invoice.
  address       String

  /// The exact figure to send, as a decimal string. Never a float: 0.1 + 0.2
  /// is not 0.3, and a payment matcher that rounds is one that rejects correct
  /// payments.
  amount        String
  /// The same figure in the chain's base units — satoshis, or USDT×10⁶. This
  /// is what the comparison actually runs on, as an exact integer string.
  amountUnits   String

  /// Price in US cents at the moment the invoice was raised.
  priceCents    Int
  /// The asset's USD rate used for the conversion, pinned at issue.
  rate          String

  /// PENDING | SEEN | CONFIRMED | EXPIRED | MISMATCH
  ///
  /// SEEN means a transfer of the right amount is on the chain but has not yet
  /// met the confirmation threshold. It is deliberately its own state: telling
  /// somebody "not paid" while their transaction sits in a block is how support
  /// queues fill up.
  status        String   @default("PENDING")
  statusDetail  String?

  txid          String?
  confirmations Int      @default(0)
  /// What actually arrived, when it differs from what was asked for. Shown to
  /// the payer verbatim rather than rounded away.
  receivedUnits String?

  seenAt        DateTime?
  confirmedAt   DateTime?
  expiresAt     DateTime
  /// Rate-limits the explorer polling. The client polls this row; this row
  /// decides whether that warrants asking a public API again.
  lastCheckedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([chain, amountUnits, status])
}

model Membership {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id])
  organisationId String       @db.ObjectId
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// OWNER | ISSUER | VIEWER. Issuing a document is the privileged action —
  /// it puts an organisation's name and seal on a page — so it is not the
  /// default a new member gets.
  role           String       @default("VIEWER")
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([organisationId])
}

/// Single-use credentials. Carried over wholesale from the system this
/// descends from, including the lesson that cost most to learn there: `usedAt`
/// is written explicitly as null at creation, because Prisma's MongoDB
/// connector distinguishes an absent field from a null one and every redemption
/// is guarded on `usedAt: null`. Leaving it off makes the guard match nothing
/// and silently refuses every correct code.
model AuthToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id])
  purpose   String    // LOGIN | PASSWORD_RESET | EMAIL_VERIFY
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int?      @default(0)
  issuedBy  String?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

/// A reusable document shape: letter, certificate, notice, statement.
///
/// The layout engine is shared; a template supplies the copy scaffolding and
/// which blocks appear. That keeps one renderer to maintain rather than one per
/// document type, which is how these systems usually rot.
model DocumentTemplate {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organisationId String       @db.ObjectId
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name           String
  /// LETTER | CERTIFICATE | NOTICE | STATEMENT
  kind           String       @default("LETTER")
  /// Printed under the letterhead, e.g. "Official correspondence".
  documentTitle  String       @default("Official correspondence")
  subject        String       @default("")
  body           String       @default("")
  classification String       @default("Private & Confidential")
  department     String       @default("")
  /// Blocks this template draws: seal, watermark, qr, microtext, frame.
  features       String       @default("seal,watermark,qr,microtext,frame")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
}

/// Someone who signs on an organisation's behalf.
model Signatory {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organisationId String       @db.ObjectId
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  name       String
  title      String @default("")
  department String @default("")
  /// Two-letter prefix for authorization ids; falls back to the department.
  prefix     String?
  /// Optional uploaded signature image, as a data URL. Absent means the name
  /// is set in a script face instead, which is a facsimile either way.
  signature  String?
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())

  @@index([organisationId, isActive])
}

/// An issued document. The register the verification portal answers from.
///
/// Deliberately does NOT store the body. A verification page that reprints the
/// document turns a reference number into a way to read other people's
/// correspondence, and references travel on the outside of envelopes. What is
/// kept is what a recipient can already see on the paper in front of them, so
/// they can compare — and the fingerprint, so an altered field shows up.
model Document {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organisationId String       @db.ObjectId
  organisation   Organisation @relation(fields: [organisationId], references: [id])

  /// Printed on the document and encoded in the QR. Unique per organisation,
  /// not globally: two tenants may legitimately both use "0001".
  reference       String
  verificationId  String
  /// SHA-256 over the canonical field set. Printed on the paper and shown on
  /// the portal, so a reader can detect an altered field themselves. The portal
  /// never receives the document and cannot check this for them.
  fingerprint     String       @default("")

  kind            String       @default("LETTER")
  documentTitle   String       @default("")
  recipientName   String       @default("")
  subject         String       @default("")
  department      String       @default("")
  classification  String       @default("")
  signerName      String       @default("")
  signerTitle     String       @default("")
  authorizationId String       @default("")
  issuedOn        String       @default("")

  /// ACTIVE | PENDING | EXPIRED | REVOKED
  status          String       @default("ACTIVE")
  statusReason    String?

  generatedAt     DateTime     @default(now())
  lastVerifiedAt  DateTime?
  verifyCount     Int?         @default(0)
  issuedBy        String?
  createdAt       DateTime     @default(now())

  @@unique([organisationId, reference])
  @@index([organisationId, createdAt])
  @@index([status])
}

/// Work in progress. Unversioned on purpose: a draft is scaffolding, and a
/// history of scaffolding is something nobody asked for and everybody scrolls
/// past.
model Draft {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  organisationId String   @db.ObjectId
  title          String
  kind           String   @default("LETTER")
  payload        String   @default("{}")
  reference      String   @default("")
  savedBy        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organisationId, updatedAt])
}
