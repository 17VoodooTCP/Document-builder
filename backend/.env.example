PORT=4000
NODE_ENV=development

# MongoDB Atlas.
#
# MUST include a database name between the host and the query string:
#   mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/docbuilder?retryWrites=true&w=majority
#
# Atlas's copy button omits it and gives you ".../?retryWrites=..." — that fails
# at runtime with "empty database name not allowed", and the health check will
# stay green while every query dies.
DATABASE_URL=

JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated origins allowed to call this API.
FRONTEND_URL=http://localhost:5173

# Where QR codes point. The frontend's public origin, no trailing slash.
PUBLIC_URL=http://localhost:5173
