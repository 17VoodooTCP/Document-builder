PORT=4000
NODE_ENV=development

# MongoDB Atlas.
#
# MUST include a database name between the host and the query string:
#   mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/docbuilder?retryWrites=true&w=majority
#
# Atlas's copy button omits it and gives you ".../?retryWrites=..." — that fails
# at runtime with "empty database name not allowed", and the health check will
# stay green while every query dies.
DATABASE_URL=

JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated origins allowed to call this API.
FRONTEND_URL=http://localhost:5173

# Where QR codes point. The frontend's public origin, no trailing slash.
PUBLIC_URL=http://localhost:5173

# ── Paid access ──────────────────────────────────────────────────────────────
#
# One-off unlock per account, settled on-chain and watched by the API itself.
# There is no processor and no custody: funds land directly in these wallets,
# and nothing in this codebase holds a key that could move them.
#
# An asset with no address here is reported as unavailable and is not offered
# on the unlock page — better than an invoice nobody can pay.

# Price in whole dollars. Defaults to 49.
UNLOCK_PRICE_USD=49

# Your own receiving addresses. Check these twice: a typo sends real customer
# payments somewhere neither you nor they can reach.
BTC_ADDRESS=
# USDT on Tron (TRC-20) ONLY. An address for any other chain will silently
# never match, because the watcher filters on the TRC-20 USDT contract.
USDT_TRON_ADDRESS=

# Optional. TronGrid works without one at a lower rate limit; set it if the
# unlock page starts reporting the explorer as unreachable.
TRONGRID_API_KEY=
